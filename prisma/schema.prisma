generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────────────────────────────────

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SectionType {
  STORY
  FEATURES
  HARDWARE
  SOFTWARE
  TECHNICAL
  HOW_IT_WORKS
  TESTING
  CHALLENGES
  LESSONS
  RESEARCH
  FUTURE
  GALLERY
}

enum MediaRole {
  COVER
  HERO
  GALLERY
  DIAGRAM
  HARDWARE
  TESTING
  OTHER
}

enum JourneyType {
  MILESTONE
  PROJECT
  ONGOING
}

// ── Models ─────────────────────────────────────────────────────────────────────

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  oneLine        String?
  year           Int?
  category       String?
  status         ProjectStatus @default(DRAFT)
  featured       Boolean       @default(false)
  showOnHomepage Boolean       @default(false)
  displayOrder   Int           @default(0)

  // Story fields
  description String? @db.Text
  problem     String? @db.Text
  designed    String? @db.Text
  howItWorks  String? @db.Text
  engineering String? @db.Text
  result      String? @db.Text
  learned     String? @db.Text

  // Technical
  technologies String[]

  // SEO
  seoTitle       String?
  seoDescription String?
  ogImage        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sections          ProjectSection[]
  projectSkills     ProjectSkill[]
  media             Media[]
  journeyProjects   JourneyProject[]
  researchProjects  ResearchProject[]
  relatedProjects   ProjectRelatedProject[] @relation("ProjectToRelated")
  relatedBy         ProjectRelatedProject[] @relation("RelatedToProject")

  @@index([status])
  @@index([category])
  @@index([year])
  @@index([featured])
  @@index([showOnHomepage])
  @@index([displayOrder])
  @@index([slug])
}

model ProjectSection {
  id          String      @id @default(cuid())
  projectId   String
  sectionType SectionType
  title       String?
  content     String?     @db.Text
  visible     Boolean     @default(true)
  displayOrder Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([sectionType])
  @@index([displayOrder])
}

model SkillGroup {
  id           String @id @default(cuid())
  name         String
  slug         String @unique
  description  String?
  displayOrder Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills Skill[]

  @@index([displayOrder])
}

model Skill {
  id           String @id @default(cuid())
  name         String
  slug         String @unique
  skillGroupId String?
  displayOrder Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skillGroup   SkillGroup?    @relation(fields: [skillGroupId], references: [id], onDelete: SetNull)
  projectSkills ProjectSkill[]

  @@index([skillGroupId])
  @@index([displayOrder])
}

model ProjectSkill {
  projectId String
  skillId   String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
  @@index([skillId])
}

model JourneyEntry {
  id           String      @id @default(cuid())
  year         Int
  title        String
  description  String?     @db.Text
  type         JourneyType @default(MILESTONE)
  displayOrder Int         @default(0)
  visible      Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journeyProjects JourneyProject[]

  @@index([year])
  @@index([type])
  @@index([displayOrder])
  @@index([visible])
}

model JourneyProject {
  journeyId String
  projectId String

  journey JourneyEntry @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([journeyId, projectId])
  @@index([projectId])
}

model ResearchEntry {
  id           String  @id @default(cuid())
  title        String
  slug         String  @unique
  description  String? @db.Text
  links        Json?
  displayOrder Int     @default(0)
  visible      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  researchProjects ResearchProject[]

  @@index([displayOrder])
  @@index([visible])
  @@index([slug])
}

model ResearchProject {
  researchId String
  projectId  String

  research ResearchEntry @relation(fields: [researchId], references: [id], onDelete: Cascade)
  project  Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([researchId, projectId])
  @@index([projectId])
}

model Achievement {
  id           String  @id @default(cuid())
  title        String
  description  String? @db.Text
  year         Int?
  category     String?
  displayOrder Int     @default(0)
  visible      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([year])
  @@index([category])
  @@index([displayOrder])
  @@index([visible])
}

model Media {
  id           String    @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  alt          String?
  caption      String?
  role         MediaRole @default(OTHER)
  projectId    String?
  displayOrder Int       @default(0)
  visible      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([role])
  @@index([displayOrder])
  @@index([visible])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  createdAt DateTime @default(now())
}

model ProjectRelatedProject {
  projectId        String
  relatedProjectId String

  project        Project @relation("ProjectToRelated", fields: [projectId], references: [id], onDelete: Cascade)
  relatedProject Project @relation("RelatedToProject", fields: [relatedProjectId], references: [id], onDelete: Cascade)

  @@id([projectId, relatedProjectId])
  @@index([relatedProjectId])
}
